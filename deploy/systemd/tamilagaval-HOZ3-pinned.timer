[Unit]
Description=Fire tamilagaval-HOZ3-pinned.service once at 2026-08-28 11:57 UTC (~6 min after premiere start)
# Premiere: 2026-08-28 11:51 UTC. Song is ~5 min; +6 min lands just after premiere
# ends and the live chat has settled but the pinned comment still catches
# post-premiere replay viewers landing on the video page.

[Timer]
OnCalendar=2026-08-28 11:57:00 UTC
RandomizedDelaySec=30
Persistent=false
Unit=tamilagaval-HOZ3-pinned.service

[Install]
WantedBy=timers.target
