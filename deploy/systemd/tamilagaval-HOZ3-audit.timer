[Unit]
Description=Fire tamilagaval-HOZ3-audit.service once at 2026-08-31 12:00 UTC (~72h post-premiere, revenue settled)
# Premiere: 2026-08-28 11:51 UTC. +72h ~ 2026-08-31 11:51 UTC; rounded to noon UTC
# to keep all post-premiere timers on the same cadence for predictability.

[Timer]
OnCalendar=2026-08-31 12:00:00 UTC
RandomizedDelaySec=60
Persistent=false
Unit=tamilagaval-HOZ3-audit.service

[Install]
WantedBy=timers.target
