[Unit]
Description=Fire tamilagaval-QDJG-audit.service once at 2026-09-15 12:00 UTC (~72h post-premiere, revenue settled)
# Premiere: 2026-09-12 12:33 UTC (scheduledStartTime). +72h ~ 2026-09-15 12:33 UTC;
# rounded to noon UTC to keep all post-premiere timers on the same cadence.

[Timer]
OnCalendar=2026-09-15 12:00:00 UTC
RandomizedDelaySec=60
Persistent=false
Unit=tamilagaval-QDJG-audit.service

[Install]
WantedBy=timers.target
