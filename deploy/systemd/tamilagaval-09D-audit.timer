[Unit]
Description=Fire tamilagaval-09D-audit.service once at 2026-08-29 12:00 UTC (~72h post-premiere, revenue settled)
# Premiere: 2026-08-26 11:49 UTC. +72h ~ 2026-08-29 11:49 UTC; rounded to noon UTC
# to keep all post-premiere timers on the same cadence for predictability.

[Timer]
OnCalendar=2026-08-29 12:00:00 UTC
RandomizedDelaySec=60
Persistent=false
Unit=tamilagaval-09D-audit.service

[Install]
WantedBy=timers.target
