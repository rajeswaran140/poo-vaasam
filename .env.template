# .env.template — inventory of every runtime setting Tamilagaval depends on.
#
# THIS FILE IS NOT USED BY THE APP. It is the source-of-truth INVENTORY of
# what has to be re-created to rebuild the app on a fresh Amplify project.
# Values live in one of two places:
#   1. Amplify app-level Environment Variables (non-secret config + a couple
#      of public keys). Set these in the AWS console: Amplify → app → Env vars.
#   2. AWS Systems Manager Parameter Store SecureStrings (secrets). Set these
#      via the AWS console or `aws ssm put-parameter`; the Amplify build reads
#      them at runtime via the SSM helper wired into next.config.ts.
# See deploy/backup-ssm.sh for a scripted encrypted backup of (2).
#
# When you add a new env-driven setting to the code, add it here too so the
# next rebuild has a checklist.

# ═══════════════════════════════════════════════════════════════════════════
# 1. Amplify Environment Variables (Console → Amplify → App → Env vars)
#    17 vars as of 2026-08-29 audit.
# ═══════════════════════════════════════════════════════════════════════════

# Non-secret configuration
NODE_ENV=production
NEXT_PUBLIC_AWS_REGION=ca-central-1
DYNAMODB_TABLE_NAME=TamilWebContent            # the single-table DDB in ca-central-1
NEXT_PUBLIC_S3_BUCKET=tamil-web-media          # media bucket, us-east-1
S3_BUCKET=tamil-web-media                      # server-side alias for the same bucket
MEDIA_BASE_URL=https://d2cdoh43143xxa.cloudfront.net  # CloudFront in front of S3

# Cognito (values are non-secret IDs, safe in NEXT_PUBLIC_)
NEXT_PUBLIC_USER_POOL_ID=                      # e.g. ca-central-1_JPXdswqHE
NEXT_PUBLIC_USER_POOL_CLIENT_ID=

# Web Push (VAPID) — public key is safe to expose; private key lives in SSM
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=                              # server-side twin of NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:                          # RFC 8292 subject identifier

# YouTube OAuth — client_id is safe to expose (paired with the SSM client_secret)
YOUTUBE_OAUTH_CLIENT_ID=

# GA4
GA4_PROPERTY_ID=

# Admin + contact
ADMIN_EMAILS=                                  # comma-separated list of admin emails (Cognito auth gate)
CONTACT_NOTIFY_FROM=                           # SES verified sender for outbound contact-form notifications
CONTACT_NOTIFY_TO=

# LLM engine selection
AUX_AI_ENGINE=gemini                           # fallback engine; primary is Anthropic


# ═══════════════════════════════════════════════════════════════════════════
# 2. SSM Parameter Store SecureStrings (secrets — set via `aws ssm put-parameter`)
#    Read at Amplify build time; 13 params as of 2026-08-29 audit.
#    Prefix: /amplify/d3rkmepk4popv0/master/<NAME>
# ═══════════════════════════════════════════════════════════════════════════
#
# ANTHROPIC_API_KEY               # primary LLM
# OPENAI_API_KEY                  # legacy LLM path (still referenced)
# YOUTUBE_API_KEY                 # Data API v3 read-only
# YOUTUBE_OAUTH_CLIENT_SECRET     # pairs with YOUTUBE_OAUTH_CLIENT_ID above
# YOUTUBE_ANALYTICS_REFRESH_TOKEN # yt-analytics.readonly + yt-analytics-monetary.readonly scope
# YOUTUBE_DATA_REFRESH_TOKEN      # youtube.force-ssl scope (writes: comments, playlists, videos.update)
# GA4_SERVICE_ACCOUNT_KEY         # GA4 Data API JSON service-account credential
# GOOGLE_TTS_CREDENTIALS_BASE64   # Google TTS service-account JSON (base64)
# APP_AWS_ACCESS_KEY_ID           # IAM user for server-side S3 / DDB writes (rotate quarterly)
# APP_AWS_SECRET_ACCESS_KEY       # pair with APP_AWS_ACCESS_KEY_ID
# VAPID_PRIVATE_KEY               # web-push signing key
# LYRICS_GATE_SECRET              # HMAC secret for the lyrics-download gate
# CRON_SECRET                     # Amplify-cron header validation
#
# Additional non-Amplify SSM prefixes Tamilagaval uses:
#   /tamilagaval/prod/ANTHROPIC_API_KEY       # non-Amplify runtime (workers)
#   /tamilagaval/prod/GEMINI_API_KEY          # non-Amplify runtime (workers)
#   /tamilagaval/prod/cron-secret             # non-Amplify runtime (workers)
#   /tamilagaval/e2e/admin-password           # Playwright E2E test creds


# ═══════════════════════════════════════════════════════════════════════════
# 3. NOT env-driven, but part of the same reconstruction picture — flag here
#    so the DR runbook covers them.
# ═══════════════════════════════════════════════════════════════════════════
#
# - Cognito user pool ca-central-1_JPXdswqHE (1 user, MFA required). If deleted,
#   Raj re-signs up; downstream references to his `sub` UUID may need reseeding.
# - CloudFront distribution for tamilagaval.com (Amplify-managed) + the media
#   distribution for d2cdoh43143xxa.cloudfront.net over tamil-web-media.
# - The 5 Lambda functions (compose-worker, master-worker, measure-fn,
#   yt-snapshot, matchering-worker). Code redeployable from the repo scripts
#   (npm run deploy:worker etc.), but their inline environment variables are
#   not currently backed up — a next PR should mirror this template for those.
