{
  "name": "poo-vaasam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:tts": "node scripts/test-tts-config.js",
    "aws:setup": "npm run aws:dynamodb && npm run aws:s3",
    "aws:dynamodb": "tsx scripts/create-dynamodb-table.ts",
    "aws:s3": "tsx scripts/create-s3-bucket.ts",
    "build:worker": "esbuild worker/compose-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=worker-dist/index.js --external:@aws-sdk/* --tsconfig=tsconfig.json",
    "deploy:worker": "npm run build:worker && cd worker-dist && zip -q -r ../worker.zip index.js && cd .. && aws lambda update-function-code --function-name tamilagaval-compose-worker --zip-file fileb://worker.zip --region ca-central-1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-amplify/ui-react": "^5.3.3",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@google-analytics/data": "^6.1.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@heroicons/react": "^2.2.0",
    "aws-amplify": "^5.3.33",
    "aws-jwt-verify": "^5.1.1",
    "lucide-react": "1.8.0",
    "next": "^15.5.18",
    "openai": "^6.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-transliterate": "1.1.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
