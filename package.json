{
  "name": "poo-vaasam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:tts": "node scripts/test-tts-config.js",
    "align:lyrics": "tsx scripts/align-lyrics.ts",
    "fixtures:make": "bash scripts/make-fixtures.sh test/fixtures/audio",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts test/fixtures/audio",
    "aws:setup": "npm run aws:dynamodb && npm run aws:s3",
    "aws:dynamodb": "tsx scripts/create-dynamodb-table.ts",
    "aws:s3": "tsx scripts/create-s3-bucket.ts",
    "build:worker": "esbuild worker/compose-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=worker-dist/index.js --external:@aws-sdk/* --tsconfig=tsconfig.json",
    "deploy:worker": "npm run build:worker && cd worker-dist && zip -q -r ../worker.zip index.js && cd .. && aws lambda update-function-code --function-name tamilagaval-compose-worker --zip-file fileb://worker.zip --region ca-central-1",
    "build:measure-fn": "esbuild worker/measure-fn.ts --bundle --platform=node --target=node20 --format=cjs --outfile=measure-fn-dist/index.js --external:@aws-sdk/* --tsconfig=tsconfig.json",
    "deploy:measure-fn": "npm run build:measure-fn && cd measure-fn-dist && zip -q -r ../measure-fn.zip index.js && cd .. && aws lambda update-function-code --function-name tamilagaval-measure-fn --zip-file fileb://measure-fn.zip --region ca-central-1",
    "build:master-worker": "esbuild worker/master-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=master-worker-dist/index.js --external:@aws-sdk/* --tsconfig=tsconfig.json",
    "deploy:master-worker": "npm run build:master-worker && cd master-worker-dist && zip -q -r ../master-worker.zip index.js && cd .. && aws lambda update-function-code --function-name tamilagaval-master-worker --zip-file fileb://master-worker.zip --region ca-central-1",
    "deploy:matchering-worker": "bash scripts/deploy-matchering-worker.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-amplify/ui-react": "^5.3.3",
    "@aws-sdk/client-amplify": "3.1033.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1033.0",
    "@aws-sdk/client-ssm": "^3.1116.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fontsource/baloo-thambi-2": "^5.3.0",
    "@fontsource/kavivanar": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@google-analytics/data": "^6.1.0",
    "@google-cloud/bigquery": "^9.0.3",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^2.8.0",
    "@heroicons/react": "^2.2.0",
    "aws-amplify": "^5.3.33",
    "aws-jwt-verify": "^5.1.1",
    "lucide-react": "1.8.0",
    "next": "^15.5.21",
    "openai": "^6.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-transliterate": "1.1.9",
    "web-push": "^3.6.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.0",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "lodash": "^4.18.1"
  }
}
